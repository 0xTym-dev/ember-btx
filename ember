#!/usr/bin/env bash
# ember — AMD GPU miner for BTX. User entrypoint.
#
#   ./ember --address <btx1z...> --worker rig1
#
# Everything after is passed through to the miner; later flags override the
# defaults below, so you can add --batch-size, --pool, --log-level, etc.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Locate the bundled solver binary (release layout first, then dev layout).
SOLVER=""
for c in "$ROOT/bin/btx-gbt-solve" "$ROOT/solver-src/build/bin/btx-gbt-solve"; do
  [ -x "$c" ] && { SOLVER="$c"; break; }
done
if [ -z "$SOLVER" ]; then
  echo "ember: solver binary not found (looked in bin/ and solver-src/build/bin/)." >&2
  echo "Run ./install.sh or build it with ./build-solver.sh first." >&2
  exit 1
fi

# Locate the Python client.
CLIENT_SRC="$ROOT/client/src"
if [ ! -d "$CLIENT_SRC/dexbtx_miner" ]; then
  echo "ember: client not found at $CLIENT_SRC." >&2
  exit 1
fi

# ROCm runtime libs. Native ROCm lives in /opt/rocm; WSL2 too after
# amdgpu-install --usecase=wsl,rocm. Prepend if present; keep any existing path.
if [ -d /opt/rocm/lib ]; then
  export LD_LIBRARY_PATH="/opt/rocm/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
export PYTHONPATH="$CLIENT_SRC${PYTHONPATH:+:$PYTHONPATH}"

# The stock dexbtx client can auto-replace the solver with an upstream (NVIDIA)
# binary — that would clobber the AMD build. Keep these OFF, always.
export DEXBTX_NO_SOLVER_AUTOUPDATE=1
export DEXBTX_NO_SOLVER_RECHECK=1
export DEXBTX_NO_WRAPPER_AUTOUPDATE=1

# Extract Ember's own flags (--gui dashboard, --deep-tune auto-tuner) so they
# don't reach the miner; everything else passes through untouched.
GUI=0; GUI_PORT=8787; GUI_OPEN=1
TUNE=0; TUNE_WINDOW=120; TUNE_WARMUP=40; TUNE_OBJECTIVE=throughput
PASS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --gui)            GUI=1; shift ;;
    --gui-port)       GUI_PORT="$2"; shift 2 ;;
    --no-open)        GUI_OPEN=0; shift ;;
    --deep-tune)      TUNE=1; shift ;;
    --tune-window)    TUNE_WINDOW="$2"; shift 2 ;;
    --tune-warmup)    TUNE_WARMUP="$2"; shift 2 ;;
    --tune-objective) TUNE_OBJECTIVE="$2"; shift 2 ;;
    *)                PASS+=("$1"); shift ;;
  esac
done

# Detect the GPU arch (best-effort) so we can load a per-card tuned profile.
GFX="$(rocminfo 2>/dev/null | grep -oE 'gfx[0-9]{3,}' | sort -u | head -1)"
[ -z "$GFX" ] && GFX="unknown"

# Defaults, overridable by (a) a DEEP TUNE profile, then (b) explicit flags.
#  - batch-size 384 / prepare-workers 16: tuned on RX 7800 XT (gfx1101).
BATCH=384; WORKERS=16
TUNEFILE="${HOME}/.ember/tune-${GFX}.json"
if [ -f "$TUNEFILE" ]; then
  # pull batch_size / prepare_workers from the saved profile
  read -r _b _w < <(python3 - "$TUNEFILE" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(int(d.get("batch_size", 384)), int(d.get("prepare_workers", 16)))
except Exception:
    print(384, 16)
PY
)
  [ -n "$_b" ] && BATCH="$_b"
  [ -n "$_w" ] && WORKERS="$_w"
  echo "ember: using DEEP TUNE profile for $GFX (batch=$BATCH workers=$WORKERS)" >&2
fi

# The base miner command. User flags in "${PASS[@]}" come last, so an explicit
# --batch-size / --pool / --log-level etc. still wins over these defaults.
MINER=(python3 -m dexbtx_miner
  --pool stratum.minebtx.com:3333
  --gbt-solve "$SOLVER"
  --batch-size "$BATCH"
  --prepare-workers "$WORKERS"
  --log-level INFO
  "${PASS[@]}")

if [ "$TUNE" = "1" ]; then
  # Auto-tune: try settings, measure scan rate, save ~/.ember/tune-$GFX.json.
  exec python3 "$ROOT/gui/ember_tune.py" \
    --gfx "$GFX" --window "$TUNE_WINDOW" --warmup "$TUNE_WARMUP" \
    --objective "$TUNE_OBJECTIVE" -- "${MINER[@]}"
fi

if [ "$GUI" = "1" ]; then
  GUI_ARGS=(--port "$GUI_PORT")
  [ "$GUI_OPEN" = "0" ] && GUI_ARGS+=(--no-open)
  exec python3 "$ROOT/gui/ember_gui.py" "${GUI_ARGS[@]}" -- "${MINER[@]}"
fi

exec "${MINER[@]}"
